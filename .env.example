# Resend (https://resend.com) — required for contact form delivery
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Optional overrides (defaults shown)
CONTACT_TO_EMAIL=tatenhan@epochfinancial.com
CONTACT_FROM_EMAIL=EPOCH Financial <noreply@epochfinancial.com>

# Cloudflare Turnstile CAPTCHA (https://dash.cloudflare.com → Turnstile)
# Required in production. Without these, Cloudflare's test keys are used,
# which render the widget but always pass.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# Resend bounce webhook (Resend dashboard → Webhooks → Add endpoint)
# URL: https://www.epochfinancial.com/api/resend-webhook  Events: email.bounced, email.complained
RESEND_WEBHOOK_SECRET=whsec_...

# Anti-spam tuning (optional)
CONTACT_RATE_LIMIT=3               # submissions per IP per hour
BLOCK_FREE_EMAIL_DOMAINS=false     # true = reject gmail/yahoo/etc on all forms
